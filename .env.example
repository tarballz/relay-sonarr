# Copy to .env and fill in. Get each key from Sonarr → Settings → General → API Key.
# .env is gitignored and never baked into the image — keys stay server-side.
SONARR_1080P_API_KEY=your-1080p-instance-api-key
SONARR_4K_API_KEY=your-4k-instance-api-key

# Optional: enable defense-in-depth verification of the Cloudflare Access JWT.
# Leave CF_ACCESS_ENABLED=false until the tunnel + Access app are configured.
CF_ACCESS_ENABLED=false
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=your-access-application-aud-tag

# Optional: logging verbosity (DEBUG, INFO, WARNING, ERROR). Default INFO.
LOG_LEVEL=INFO

# Optional: LOG_FORMAT=json writes one JSON object per log line (for log shippers).
LOG_FORMAT=text

# Optional: require "Authorization: Bearer <token>" on GET /metrics. /metrics is
# exempt from Cloudflare Access so a LAN Prometheus can scrape it.
# METRICS_TOKEN=

# Optional kill switches for the autonomous reconciler and its sweeps (default true).
# RECONCILER_ENABLED=false stages a deploy without the background loop; drive
# POST /api/reconcile/tick by hand, then flip it back on.
RECONCILER_ENABLED=true
STALLED_CLEANUP_ENABLED=true
DANGEROUS_CLEANUP_ENABLED=true
SEARCH_STALL_CLEANUP_ENABLED=true
