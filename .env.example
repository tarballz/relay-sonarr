# Copy to .env and fill in. Get each key from Sonarr → Settings → General → API Key.
# .env is gitignored and never baked into the image — keys stay server-side.
SONARR_1080P_API_KEY=your-1080p-instance-api-key
SONARR_4K_API_KEY=your-4k-instance-api-key

# Optional: enable defense-in-depth verification of the Cloudflare Access JWT.
# Leave CF_ACCESS_ENABLED=false until the tunnel + Access app are configured.
CF_ACCESS_ENABLED=false
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=your-access-application-aud-tag
